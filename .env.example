# Copy to `.env` on the machine that runs the app and fill in what you have.
# `.env` is git-ignored. Never commit real keys, never paste them into chats.
# Empty value = that integration stays switched off.

GMW_ENV=dev
GMW_LOG_LEVEL=INFO

# Phase 2 — macro data
GMW_FRED_API_KEY=
GMW_BOK_ECOS_API_KEY=

# Phase 4 — live prices
GMW_FINNHUB_API_KEY=
GMW_ALPACA_KEY_ID=
GMW_ALPACA_SECRET=
GMW_IG_API_KEY=
GMW_IG_USERNAME=
GMW_IG_PASSWORD=

# Phase 6 — alerts
GMW_TELEGRAM_BOT_TOKEN=
GMW_TELEGRAM_CHAT_ID=

# Phase 8 — portfolio (READ-ONLY key: account data, history, portfolio — never orders)
GMW_T212_API_KEY=
GMW_T212_API_SECRET=

# Phase 9 — Claude bridge (fine-grained token, access to gmw-bridge repo only)
GMW_GITHUB_BRIDGE_TOKEN=
