{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run GlobalMarketWatch",
      "detail": "Starts the app on port 8000 and keeps its log visible in this terminal",
      "type": "shell",
      "command": "uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
